<mxfile host="app.diagrams.net"><diagram name="Wireflow"><mxGraphModel dx="1420" dy="880" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Wireflow por Rol — Responsable de Obra — ROL: SITE_MANAGER" style="text;html=1;fontSize=18;fontStyle=1;fillColor=none;strokeColor=none;fontColor=#1B3F7A;" vertex="1" parent="1"><mxGeometry x="30" y="15" width="900" height="36" as="geometry"/></mxCell><mxCell id="login" value="&lt;b&gt;1. Inicio de Sesión&lt;/b&gt;&lt;br/&gt;/iniciar-sesion&lt;br/&gt;- Credenciales + Bearer token&lt;br/&gt;- Validación por rol&lt;br/&gt;- Redirección a /inicio" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B3F7A;strokeWidth=2;fontColor=#0F172A;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="270" height="175" as="geometry"/></mxCell><mxCell id="home" value="&lt;b&gt;2. Inicio de Obra&lt;/b&gt;&lt;br/&gt;/inicio&lt;br/&gt;- Resumen de obra asignada&lt;br/&gt;- Accesos directos a rutas&lt;br/&gt;- Selector de idioma ES/EN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B3F7A;strokeWidth=2;fontColor=#0F172A;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="380" y="140" width="290" height="175" as="geometry"/></mxCell><mxCell id="sites" value="&lt;b&gt;Obras Asignadas&lt;/b&gt;&lt;br/&gt;/obras&lt;br/&gt;- Catálogo de obras del usuario&lt;br/&gt;- Estado y avance por frente" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0369A1;strokeWidth=2;fontColor=#0F172A;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="760" y="130" width="320" height="145" as="geometry"/></mxCell><mxCell id="orders" value="&lt;b&gt;Solicitudes de Material&lt;/b&gt;&lt;br/&gt;/solicitudes&lt;br/&gt;- Crear pedido de obra (US-03)&lt;br/&gt;- Consultar aprobación/rechazo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0369A1;stro