<mxfile host="app.diagrams.net"><diagram name="Wireflow"><mxGraphModel dx="1420" dy="880" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Wireflow por Rol — Administrador / Supervisor — ROL: ADMIN / SUPERVISOR" style="text;html=1;fontSize=18;fontStyle=1;fillColor=none;strokeColor=none;fontColor=#1B3F7A;" vertex="1" parent="1"><mxGeometry x="30" y="15" width="900" height="36" as="geometry"/></mxCell><mxCell id="login" value="&lt;b&gt;1. Inicio de Sesión&lt;/b&gt;&lt;br/&gt;/iniciar-sesion&lt;br/&gt;- Cuenta ADMIN verificada&lt;br/&gt;- Acceso transversal completo&lt;br/&gt;- Token Bearer 8 h" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B3F7A;strokeWidth=2;fontColor=#0F172A;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="270" height="175" as="geometry"/></mxCell><mxCell id="home" value="&lt;b&gt;2. Panel de Supervisión&lt;/b&gt;&lt;br/&gt;/inicio&lt;br/&gt;- Indicadores globales en vivo&lt;br/&gt;- Alertas prioritarias de obra&lt;br/&gt;- Acceso a todos los módulos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B3F7A;strokeWidth=2;fontColor=#0F172A;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="380" y="140" width="310" height="175" as="geometry"/></mxCell><mxCell id="ops" value="&lt;b&gt;Operación Integral&lt;/b&gt;&lt;br/&gt;/obras · /materiales · /solicitudes&lt;br/&gt;- Supervisión de proyectos&lt;br/&gt;- Control de despachos y flota&lt;br/&gt;- /despachos · /transporte" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0369A1;strokeWidth=2;fontColor=#0F172A;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="780" y="130" width="330" height="165" as="geometry"/></mxCell><mxCell id="settings" value="&lt;b&gt;Configuración y Usuarios&lt;/b&gt;&lt;br/&gt;/configuracion&lt;br/&gt;- Gestión de cuentas y roles&lt;br/&gt;- Política de idioma ES/EN&lt;br/&gt;- Consulta de leads (API)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=2;fontColor=#0F172A;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1180" y="130" width="290" height="165" as="geometry"/></mxCell><mxCell id="receptions" value="&lt;b&gt;3. Recepciones (Supervisor)&lt;/b&gt;&lt;br/&gt;/recepciones&lt;br/&gt;- Filtros por obra y estado&lt;br/&gt;- Tabla desplazable + detalle&lt;br/&gt;- Miniaturas de evidencia&lt;br/&gt;- Confirmar o reportar" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F5A623;strokeWidth=2;fontColor=#0F172A;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="380" y="395" width="340" height="195" as="geometry"/></mxCell><mxCell id="issues" value="&lt;b&gt;4. Discrepancias y Evidencia&lt;/b&gt;&lt;br/&gt;/problemas · /problemas/:id&lt;br/&gt;- Lista de casos abiertos&lt;br/&gt;- Línea de tiempo consolidada&lt;br/&gt;- Fotos protegidas con Bearer&lt;br/&gt;- Determinar responsabilidad" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B91C1C;strokeWidth=2;fontColor=#0F172A;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="800" y="395" width="330" height="195" as="geometry"/></mxCell><mxCell id="pdf" value="&lt;b&gt;5. Reporte de Sustento&lt;/b&gt;&lt;br/&gt;/problemas/:id (PDF)&lt;br/&gt;- Generación PDF autenticado&lt;br/&gt;- Incluye ID foto y leyenda&lt;br/&gt;- Cierre auditable del caso" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#15803D;strokeWidth=2;fontColor=#0F172A;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1200" y="395" width="270" height="195" as="geometry"/></mxCell><mxCell id="history" value="&lt;b&gt;Historial Transaccional&lt;/b&gt;&lt;br/&gt;/historial&lt;br/&gt;- Registro inmutable de cambios&lt;br/&gt;- Trazabilidad almacén–obra&lt;br/&gt;- Sin ruta /reportes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#47